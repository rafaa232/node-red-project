    {
        "id": "33acae350edb5ca5",
        "type": "function",
        "z": "e1af3ff663a9d4af",
        "name": "function 1",
        "func": "// Process Smart Bin Data - SIMPLE VERSION\ntry {\n    // Get the incoming data\n    var data = msg.payload;\n\n    // If data is string, parse to JSON\n    if (typeof data === 'string') {\n        data = JSON.parse(data);\n    }\n\n    // Create output message\n    var output = {\n        bin_id: data.bin_id || \"test_bin\",\n        fill_level: data.fill_level || 50,\n        gas_detected: data.gas_detected || false,\n        timestamp: new Date().toLocaleTimeString(),\n        status: (data.fill_level > 90) ? \"FULL\" : \"OK\"\n    };\n\n    // Return the modified message\n    msg.payload = output;\n    return msg;\n\n} catch (error) {\n    // If error, return error message\n    msg.payload = {\n        error: \"Processing failed\",\n        original_data: msg.payload\n    };\n    return msg;\n}\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 220,
        "wires": [
            [
                "e085c1875bfdd25f"
            ]
        ]
