    {
        "id": "468ab3960e3b2729",
        "type": "function",
        "z": "e45f9fac9991b339",
        "name": "function ",
        "func": "// معالجة بيانات الـ Smart Bin من Wokwi مع Servo\nif (msg && msg.payload) {\n    try {\n        var data = msg.payload;\n\n        if (typeof data === 'string') {\n            data = JSON.parse(data);\n        }\n\n        // تحديد الحالة بناءً على مستوى الامتلاء\n        var status = \"🟢 OK\";\n        var alert = false;\n\n        if (data.fill_level > 90) {\n            status = \"🔴 NEEDS EMPTYING\";\n            alert = true;\n        } else if (data.fill_level > 70) {\n            status = \"🟡 ALMOST FULL\";\n        }\n\n        // إنشاء الـ payload للDashboard\n        msg.payload = {\n            bin_id: data.bin_id || \"smart_bin_01\",\n            fill_level: Number(data.fill_level) || 0,\n            gas_detected: Boolean(data.gas_detected) || false,\n            distance_cm: data.distance_cm || 0,\n            lid_status: data.lid_status || \"CLOSED\",\n            servo_angle: data.servo_angle || 0,\n            timestamp: new Date().toLocaleTimeString(),\n            status: status,\n            alert: alert,\n            sensor_type: \"Ultrasonic + Servo\",\n            source: \"Wokwi Simulation\"\n        };\n\n    } catch (error) {\n        msg.payload = {\n            error: \"Data processing error\",\n            raw_data: msg.payload\n        };\n    }\n}\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
